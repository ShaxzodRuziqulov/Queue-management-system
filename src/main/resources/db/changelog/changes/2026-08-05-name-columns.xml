    <changeSet id="2026-08-05-014-staff-members-backfill-from-linked-user" author="codex" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists schemaName="public" tableName="staff_members"/>
                <tableExists schemaName="public" tableName="app_users"/>
                <columnExists schemaName="public" tableName="staff_members" columnName="first_name"/>
                <columnExists schemaName="public" tableName="staff_members" columnName="last_name"/>
                <columnExists schemaName="public" tableName="staff_members" columnName="linked_user_id"/>
                <columnExists schemaName="public" tableName="app_users" columnName="first_name"/>
                <columnExists schemaName="public" tableName="app_users" columnName="last_name"/>
            </and>
        </preConditions>
        <sql>
            UPDATE public.staff_members staff
            SET first_name = COALESCE(NULLIF(trim(staff.first_name), ''), users.first_name, 'Xodim'),
                last_name = COALESCE(NULLIF(trim(staff.last_name), ''), users.last_name)
            FROM public.app_users users
            WHERE staff.linked_user_id = users.id
              AND (staff.first_name IS NULL OR trim(staff.first_name) = '');
        </sql>
    </changeSet>

