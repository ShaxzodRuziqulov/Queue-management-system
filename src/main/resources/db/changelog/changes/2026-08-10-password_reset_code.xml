<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-10-001-password-reset-code" author="Shaxzod">
        <createTable tableName="password_reset_code">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="code_hash" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp(6)">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamp(6)"/>
            <column name="attempt_count" type="int" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp(6) with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="timestamp(6) with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="password_reset_code"
                baseColumnNames="user_id"
                constraintName="fk_password_reset_code_user"
                referencedTableName="app_users"
                referencedColumnNames="id"/>

        <createIndex tableName="password_reset_code" indexName="idx_password_reset_code_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
