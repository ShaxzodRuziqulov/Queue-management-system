<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2026-08-10-001-password_reset_code" author="Shaxzod">
        <addColumn tableName="password_reset_code">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="attempt_count" type="bigint"/>
            <column name="code_hash" type="varchar"/>
            <column name="expires_at" type="timestamp(6)"/>
            <column name="used_at" type="timestamp(6)"/>
            <column name="created_at" type="timestamp(6)"/>
            <column name="updated_at" type="timestamp(6)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>